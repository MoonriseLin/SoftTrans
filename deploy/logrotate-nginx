# /etc/logrotate.d/nginx — rotate the logs of the custom nginx in /usr/local/nginx.
# Daily, 14 days kept, compressed. USR1 makes nginx reopen its log files.
/var/log/nginx/*.log {
    daily
    rotate 14
    missingok
    notifempty
    compress
    delaycompress
    create 0644 root root
    sharedscripts
    postrotate
        [ -s /run/nginx.pid ] && kill -USR1 "$(cat /run/nginx.pid)" || true
    endscript
}
